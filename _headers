# Security headers for polyshares.com
# ---------------------------------------------------------------------------
# Honored by Cloudflare Pages / Netlify ONLY. GitHub Pages (current host) IGNORES
# this file. The LIVE protections today are the per-page <meta> CSP + JS frame-
# buster. The header-only controls below (X-Frame-Options, frame-ancestors,
# nosniff, HSTS) take effect the moment hosting moves to Cloudflare/Netlify.
# Kept in sync with the per-page <meta> CSP: same origins, same script hashes.
# ---------------------------------------------------------------------------

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'sha256-CRRKSCn7ZW6YErASDFEKgq3kp11/azdnedyKnxS5CuU=' 'sha256-3QJDdnoEDm+5FOzwiIdW7rIfxt1ddeuTgvAqkdD0fmw=' 'sha256-p6a8y+wRzbYFr4ZDSxfTjWTCyj4P0r0HapQq3SFVgvA=' 'sha256-IU4Z5TcumaZgBmNPq33YsOI7/E5iLsy4Dy9Q0eheJ6g=' https://assets.calendly.com https://calendly.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://assets.calendly.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.calendly.com; connect-src 'self' https://formspree.io https://*.calendly.com https://gw.polyshares.workers.dev; frame-src https://calendly.com https://assets.calendly.com; form-action 'self' https://formspree.io

# Long-cache immutable assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable
